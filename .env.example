# Copy this file to `.env` for local development only.
# Never commit real API keys.

# Optional: enables hosted embedding, generation, and review through OpenRouter.
OPENROUTER_API_KEY=

# Optional: enables Cohere embedding and rerank evaluations.
COHERE_API_KEY=

# Optional: enables Qdrant Cloud vector indexing/search.
CANON_VECTORSTORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Optional: enables OpenAlex online search expansion.
OPENALEX_API_KEY=

# Optional but recommended for hosted alpha deployments.
# Set CANON_ALLOWED_ORIGINS to your frontend URL, for example:
# https://your-user.github.io or https://your-render-service.onrender.com
CANON_ALLOWED_ORIGINS=http://localhost:8000

# Use either Basic Auth for browser access or a bearer/API key for API clients.
# Do not commit real values.
CANON_REQUIRE_AUTH=false
CANON_BASIC_AUTH_USER=
CANON_BASIC_AUTH_PASSWORD=
CANON_API_KEY=

# Serving limits.
CANON_MAX_CONCURRENCY=8
CANON_MAX_QUEUE_DEPTH=16

# Optional: override storage locations, for example on a Render disk.
CANON_DATA_DIR=
CANON_REPORTS_DIR=
