{
  "suite_id": "stage1_public_full_v1",
  "description": "Publishable Stage 1 public retrieval suite over full SciFact test qrels and full NFCorpus test qrels imported into CANON chunk-level artifacts.",
  "model_providers": [
    "local",
    "openrouter:qwen/qwen3-embedding-8b",
    "openrouter:baai/bge-m3",
    "openrouter:openai/text-embedding-3-small",
    "cohere"
  ],
  "rerankers": [
    "heuristic",
    "cohere:rerank-v4.0-fast",
    "cohere:rerank-v4.0-pro",
    "openrouter:cohere/rerank-v3.5"
  ],
  "top_k": 10,
  "candidate_k": 50,
  "pooled_candidates": true,
  "fusion_methods": ["union", "rrf", "weighted_bm25_dense"],
  "document_format": "structured",
  "thresholds": {
    "min_candidate_recall": 0.8,
    "min_rerank_recall_at_k": 0.5
  },
  "benchmarks": [
    {
      "id": "scifact_claims_full",
      "topic": "biomedical_claim_verification",
      "mode": "beir_scifact_full",
      "qrels": "gold/beir_scifact_full_qrels.json",
      "publishable_query_target": 300,
      "lexical_k": 50,
      "vector_k": 50,
      "candidate_vector_provider": "local",
      "query_variants": [
        "scientific claim evidence support refute biomedical paper abstract",
        "biomedical literature evidence claim verification",
        "relevant research abstract supporting or contradicting claim"
      ]
    },
    {
      "id": "nfcorpus_full",
      "topic": "biomedical_nutrition_retrieval",
      "mode": "beir_nfcorpus_full",
      "qrels": "gold/beir_nfcorpus_full_qrels.json",
      "publishable_query_target": 323,
      "lexical_k": 50,
      "vector_k": 50,
      "candidate_vector_provider": "local",
      "query_variants": [
        "nutrition biomedical evidence clinical document",
        "health science evidence relevant passage",
        "medical nutrition corpus retrieval query"
      ]
    }
  ]
}
